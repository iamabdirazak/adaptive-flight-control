{
  "name": "Adaptive Flight Controller",
  "task": "Position and attitude control of a compact quadrotor whose mass, inertia, motor lag and motor health are unknown or change in flight, with a cascaded PID that adapts where fixed gains were measured to fail",
  "vehicle": {
    "layout": "Quadrotor X, PX4 motor order",
    "diagonal_mm": 220,
    "mass_kg": 0.5,
    "inertia_kg_m2": [
      0.0016,
      0.0016,
      0.0028
    ],
    "thrust_to_weight": 4.0,
    "motor_time_constant_s": 0.02,
    "description": "First estimates for a 5-inch class drone, to be replaced by datasheet values"
  },
  "controller": {
    "file": "src/control/adaptive.py",
    "structure": "Cascaded PID: position, velocity, attitude on SO(3), body rate, mixer that gives up yaw first",
    "rate_hz": 500,
    "physics_rate_hz": 2000,
    "gains": {
      "position": 2.17,
      "velocity": 6.96,
      "velocity_integral": 0.51,
      "attitude": 11.39,
      "rate": 24.29,
      "rate_integral": 51.79
    },
    "gains_tuned_on": "nominal drone, 512 candidate sets, figure-eight and step, with a margin for motors twice as slow"
  },
  "adaptation": {
    "weight": {
      "method": "Hover-thrust estimation from commanded thrust and vertical acceleration, near level only",
      "time_constant_s": 0.6
    },
    "motor_lag": {
      "method": "Least squares with forgetting on how fast measured RPM closes on the command",
      "memory_s": 2.0,
      "use": "attitude and rate gains scaled by 0.045 s over the measured lag, from 0.4 to 1"
    },
    "inertia": {
      "method": "Least squares with forgetting of each motor's turning effect per axis from RPM and gyro, median of four motors",
      "memory_s": 2.0
    },
    "motor_health": {
      "method": "Steady gap between roll and pitch torque expected from RPM and torque seen by the gyro, resolved per motor",
      "smoothing_s": 0.15
    },
    "motor_failure_mode": "built, switched off (FAILURE_MODE = False)"
  },
  "test": {
    "trials_per_scenario": 200,
    "seeds": "fixed, the scenario number",
    "baseline": "Fair PID: the same cascade with fixed gains, hover-thrust estimation and rate integral, as PX4 ships",
